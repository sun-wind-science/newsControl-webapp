APP_ENV=local

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Backend
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# PostgreSQL
POSTGRES_USER=content
POSTGRES_PASSWORD=content
POSTGRES_DB=content_digest
DATABASE_URL=postgresql+psycopg://content:content@localhost:5432/content_digest

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=content-digest
MINIO_SECURE=false

# Meilisearch
MEILI_HTTP_ADDR=http://localhost:7700
MEILI_MASTER_KEY=local-master-key
